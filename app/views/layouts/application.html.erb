<!DOCTYPE html>
<html>
  <head>
    <title>AI Conf Cal — Календарь научных конференций</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
    <!-- Шапка сайта (из паршела) -->
    <%= render "shared/navbar" %>

    <!-- Системные flash-уведомления -->
    <% if notice %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg max-w-7xl mx-auto my-4 text-sm w-full"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg max-w-7xl mx-auto my-4 text-sm w-full"><%= alert %></div>
    <% end %>

    <!-- Основной контент -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500">
      © 2026 AI Conf Cal. Все права защищены.
    </footer>
  </body>
</html>