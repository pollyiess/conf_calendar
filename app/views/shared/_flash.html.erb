<% if notice.present? %>
  <div data-controller="flash" data-turbo-temporary
       class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg max-w-7xl mx-auto my-4 text-sm w-full transition-opacity duration-500">
    <%= notice %>
  </div>
<% end %>
<% if alert.present? %>
  <div data-controller="flash" data-turbo-temporary
       class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg max-w-7xl mx-auto my-4 text-sm w-full transition-opacity duration-500">
    <%= alert %>
  </div>
<% end %>