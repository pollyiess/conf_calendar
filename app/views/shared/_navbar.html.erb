<header class="bg-white border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Левая часть: Иконка и название -->
    <div class="flex items-center space-x-3">
      <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
        <!-- Векторная иконка календаря -->
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <span class="text-xl font-bold text-gray-900 tracking-tight">Conf_Cal</span>
      <% end %>
    </div>

    <!-- Навигация и кнопки авторизации -->
    <div class="flex items-center space-x-6">
      <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-gray-600">
        <%= link_to "Конференции", root_path, class: "hover:text-blue-600 transition-colors" %>
        <%= link_to "Умный подбор", "#", class: "hover:text-blue-600 transition-colors" %>
        <%= link_to "Предложить конференцию", "#", class: "hover:text-blue-600 transition-colors" %>
      </nav>

      <div class="flex items-center space-x-3">
        <% if user_signed_in? %>
          <span class="text-sm font-medium text-gray-700 hidden sm:inline"><%= current_user.email %></span>
          <%= link_to "Выйти", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors" %>
        <% else %>
          <%= link_to "Войти", new_user_session_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
          <%= link_to "Регистрация", new_user_registration_path, class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors" %>
        <% end %>
      </div>
    </div>

  </div>
</header>