<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Предстоящие конференции</h1>
    <span class="text-sm text-slate-500 font-medium">Найдено: <%= @conferences.count %></span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @conferences.any? %>
      <%= render partial: "components/conference_card", collection: @conferences, as: :conference %>
    <% else %>
      <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-slate-200">
        <p class="text-slate-500 text-sm">Предстоящих конференций пока нет.</p>
      </div>
    <% end %>
  </div>
</div>