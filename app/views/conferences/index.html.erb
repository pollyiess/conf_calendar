<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Заголовок страницы -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Предстоящие конференции</h1>
    </div>
  </div>


  <%= form_with url: conferences_path, method: :get, class: "flex flex-wrap gap-3 mb-6" do %>
    <%= select_tag :indexing,
          options_for_select([["Любая индексация", ""], ["Scopus", "scopus"], ["eLibrary", "elibrary"]], params[:indexing]),
          class: "rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm" %>
    <%= select_tag :location,
          options_for_select([["Все города", ""]] + @locations, params[:location]),
          class: "rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm" %>
    <%= submit_tag "Применить", name: nil, class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl cursor-pointer" %>
    <%= link_to "Сбросить", conferences_path, class: "px-4 py-2 text-sm text-slate-600" %>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @conferences.each do |conference| %>
      <%= render "components/conference_card", conference: conference %>
    <% end %>
  </div>

  <% if @conferences.empty? %>
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 shadow-sm">
      <p class="text-slate-500 text-lg">Пока нет предстоящих конференций.</p>
    </div>
  <% end %>

</div>