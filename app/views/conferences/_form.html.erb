<%= form_with model: conference, class: "space-y-4 bg-white border border-slate-200 rounded-2xl p-6" do |f| %>
  <% if conference.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3">
      <% conference.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
    </div>
  <% end %>

  <% input = "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
  <div><%= f.label :title, class: "text-sm font-medium" %><%= f.text_field :title, class: input %></div>
  <div><%= f.label :description, class: "text-sm font-medium" %><%= f.text_area :description, rows: 5, class: input %></div>
  <div><%= f.label :location, class: "text-sm font-medium" %><%= f.text_field :location, class: input %></div>
  <div><%= f.label :website_url, class: "text-sm font-medium" %><%= f.url_field :website_url, placeholder: "https://", class: input %></div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
    <div><%= f.label :start_date, class: "font-medium" %><%= f.date_field :start_date, class: input %></div>
    <div><%= f.label :end_date, class: "font-medium" %><%= f.date_field :end_date, class: input %></div>
    <div><%= f.label :submission_deadline, class: "font-medium" %><%= f.date_field :submission_deadline, class: input %></div>
  </div>

  <div class="flex gap-6 text-sm">
    <label><%= f.check_box :is_scopus %> Scopus</label>
    <label><%= f.check_box :is_elibrary %> eLibrary</label>
  </div>

  <%= f.submit "Сохранить", class: "px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl cursor-pointer" %>
<% end %>