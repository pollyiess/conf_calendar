{
  "name": "ConfCalendar",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.4-bookworm",
  "containerEnv": { "PORT": "3000", "BINDING": "0.0.0.0" },
  "forwardPorts": [3000],
  "postCreateCommand": "bundle install && bin/rails db:prepare && bin/rails tailwindcss:build",
  "customizations": {
    "vscode": {
      "extensions": ["Shopify.ruby-lsp", "bradlc.vscode-tailwindcss"]
    }
  }
}